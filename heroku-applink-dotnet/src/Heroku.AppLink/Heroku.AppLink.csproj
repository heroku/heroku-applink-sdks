<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Heroku.AppLink</RootNamespace>
    <PackageId>Heroku.AppLink</PackageId>
    <Version>0.1.0</Version>
    <Authors>Heroku</Authors>
    <Company>Salesforce, Inc.</Company>
    <Copyright>Copyright (c) 2026, Salesforce, Inc.</Copyright>
    <Description>Heroku AppLink SDK: parse invocations from Salesforce and look up Heroku AppLink authorizations.</Description>
    <PackageTags>heroku;salesforce;applink</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/heroku/heroku-applink-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/heroku/heroku-applink-dotnet</RepositoryUrl>
    <IsAotCompatible>true</IsAotCompatible>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Heroku.AppLink.Tests" />
  </ItemGroup>

</Project>
